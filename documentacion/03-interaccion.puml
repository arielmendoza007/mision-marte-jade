@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 14
actor Operador
participant "Entorno\n(principal)" as E
participant "Rover\n(remoto)" as R
participant "Coordinador\n(principal)" as C
Operador -> E : Iniciar escenario
E -> R : REQUEST Exploracion [M-1]
loop Por cada lectura / acción
  R -> E : QUERY_REF Exploracion [M-1]
  E -> R : INFORM Observacion(Lectura(Sector))
  R -> C : REQUEST Observacion [M-1]
  C -> R : PROPOSE Propuesta(Lectura) [M-1]
  C -> E : INFORM Propuesta [M-1]
  alt Batería y seguridad suficientes
    R -> C : ACCEPT_PROPOSAL [M-1]
    R -> E : INFORM inicio y fin de acción [M-1]
    opt Al terminar la muestra
      R -> E : INFORM regreso en curso
      R -> E : INFORM muestra en base
    end
  else Sin reserva o tormenta persistente
    R -> C : REJECT_PROPOSAL [M-1]
    R -> E : INFORM regreso en curso
    R -> E : INFORM llegada a base
  end
  E -> C : INFORM Resultado [M-1]
end
C -> E : INFORM Metricas [M-1]
E -> Operador : Mostrar resultado y medidas
@enduml
