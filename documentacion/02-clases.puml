@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 14
left to right direction
class Entorno <<Agent>> {
  - inicios : Map
  - escenarios : Map
  - medir(Exploracion, String) : Lectura
  - iniciar(String)
}
class Coordinador <<Agent>> {
  - propuestas : Map
  - respuestas : Map
  + registrarPropuesta(Propuesta)
  + registrarRespuesta(Propuesta)
}
class Rover <<Agent>> {
  - bateria : int
  - esperas : int
  - tramo : int
  - pedirLectura(boolean, boolean, boolean)
  - regresar(Propuesta, boolean, String)
}
class EscucharEntorno <<CyclicBehaviour>>
class IniciarMision <<OneShotBehaviour>>
class ConsultarRover <<OneShotBehaviour>>
class VigilarMision <<WakerBehaviour>>
class EscucharCoordinador <<CyclicBehaviour>>
class EvaluarLectura <<SimpleBehaviour>>
class PresentarseRover <<OneShotBehaviour>>
class EscucharRover <<CyclicBehaviour>>
class TelemetriaRover <<TickerBehaviour>>
class EjecutarAccion <<WakerBehaviour>>
class RegresarBase <<WakerBehaviour>>
class Observacion <<Predicate>>
class Propuesta <<Predicate>>
class Resultado <<Predicate>>
class Lectura <<Concept>>
class Sector <<Concept>>
Entorno --> EscucharEntorno
Entorno --> IniciarMision
Entorno --> ConsultarRover
Entorno --> VigilarMision
Coordinador --> EscucharCoordinador
Coordinador --> EvaluarLectura
Rover --> PresentarseRover
Rover --> EscucharRover
Rover --> TelemetriaRover
Rover --> EjecutarAccion
Rover --> RegresarBase
Entorno --> Coordinador : INFORM resultado
Coordinador --> Rover : PROPOSE
Rover --> Entorno : QUERY_REF / INFORM
Observacion *-- Lectura
Propuesta *-- Lectura
Resultado *-- Lectura
Lectura *-- Sector
@enduml
